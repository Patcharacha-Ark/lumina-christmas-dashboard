# Firebase WEB config: get from Firebase Console > Project settings > Your apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase server credential (optional if using Firebase auth) use separate service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use Application Default Credentials for the server.

# Google Sheets source. Share spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# false = allow sample dataset demo. true = require working Firebase auth + Sheets
REQUIRE_LIVE_SERVICES=false
PORT=3000
